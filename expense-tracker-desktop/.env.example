# Copy this file to ".env" (next to pom.xml) and fill in your own Supabase values.
# ".env" is ignored by git. Never commit it, and never put the service-role key here:
# only the project URL and the public anon key belong in this application.

# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Optional overrides (uncomment to customise):
# SUPABASE_STORAGE_BUCKET=expense-receipts
# SUPABASE_RECEIPT_MAX_BYTES=10485760
# TESSDATA_PREFIX=C:\path\to\tessdata
